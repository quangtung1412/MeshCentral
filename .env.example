# MeshCentral Configuration Template
# Copy file này thành .env và điền thông tin thực

# Domain Configuration
HOSTNAME=your-domain.com
REVERSE_PROXY=your-domain.com
REVERSE_PROXY_TLS_PORT=443

# Account Settings
ALLOW_NEW_ACCOUNTS=true

# Database Credentials (BẮT BUỘC PHẢI ĐỔI!)
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=meshcentral
MYSQL_USER=meshcentral
MYSQL_PASSWORD=change_this_database_password

# MeshCentral Database Config
MARIADB_HOST=mysql
MARIADB_PORT=3306
MARIADB_USER=meshcentral
MARIADB_PASS=change_this_database_password
MARIADB_DATABASE=meshcentral

# Feature Flags
WEBRTC=true
MINIFY=true
LOCAL_SESSION_RECORDING=true
ALLOWED_ORIGIN=true

# TLS Settings (true nếu dùng Cloudflare Tunnel hoặc reverse proxy)
TLS_OFFLOAD=true
